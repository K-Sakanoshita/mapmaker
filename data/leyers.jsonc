{
    "editPanels": [
        {
            "groupGlot": "panelWaters",
            "styles": [
                "sea",
                "waterArea",
                "waterLine",
                "wetland"
            ]
        },
        {
            "groupGlot": "panelLands",
            "styles": [
                "background",
                "park",
                "site",
                "garden",
                "farmland",
                "forest",
                "greenLine",
                "parking",
                "pedestrian",
                "building",
                "station",
                "barrier"
            ]
        },
        {
            "groupGlot": "panelWays",
            "styles": [
                "railway",
                "highway_motorway",
                "highway_primary",
                "highway_standard",
                "highway_substandard",
                "highway_alley",
                "highway_step"
            ]
        }
    ],
    "style": {
        "color": {
            "background": {
                "type": "background",
                "color": "#f7f6f2",
                "opacity": 1
            },
            "sea": {
                "zoom": 11,
                "type": "area",
                "color": "#cfe5f2",
                "width": 1,
                "dashArray": null,
                "linecap": "round"
            },
            "park": {
                "zoom": 15,
                "type": "area",
                "color": "#d7ead2",
                "width": 0.8,
                "dashArray": null,
                "linecap": "round"
            },
            "waterArea": {
                "zoom": 11,
                "type": "area",
                "color": "#cfe5f2",
                "width": 1,
                "dashArray": null,
                "linecap": "round"
            },
            "waterLine": {
                "zoom": 11,
                "type": "line",
                "color": "#b9d9eb",
                "width": 1,
                "dashArray": null,
                "linecap": "round"
            },
            "wetland": {
                "zoom": 11,
                "type": "area",
                "color": "#c5e3dcb3",
                "width": 0.5,
                "dashArray": null,
                "linecap": "round"
            },
            "site": {
                "zoom": 15,
                "type": "area",
                "color": "#f1e2b880",
                "width": 0.5,
                "dashArray": null,
                "linecap": "round"
            },
            "pedestrian": {
                "zoom": 15,
                "type": "area",
                "color": "#e9e7e2",
                "width": 0.5,
                "dashArray": null,
                "linecap": "round"
            },
            "garden": {
                "zoom": 16,
                "type": "area",
                "color": "#c8e2c1",
                "width": 0.3,
                "dashArray": null,
                "linecap": "round"
            },
            "farmland": {
                "zoom": 14,
                "type": "area",
                "color": "#f2e4bccc",
                "width": 0.5,
                "dashArray": null,
                "linecap": "round"
            },
            "forest": {
                "zoom": 11,
                "type": "area",
                "color": "#b9d8b5b3",
                "width": 0.9,
                "dashArray": null,
                "linecap": "round"
            },
            "greenLine": {
                "zoom": 16,
                "type": "line",
                "color": "#9fc89d",
                "width": 1.2,
                "dashArray": null,
                "linecap": "round"
            },
            "parking": {
                "zoom": 15.5,
                "type": "area",
                "color": "#deddd980",
                "width": 0.8,
                "dashArray": null,
                "linecap": "round"
            },
            "railway": {
                "zoom": 11,
                "type": "line",
                "color": "#a8a4a0",
                "width": 1.4,
                "dashArray": "0",
                "linecap": "butt",
                "overstyle": {
                    "color": "#b3b3b3",
                    "width": 4,
                    "dashArray": "1 4",
                    "linecap": "butt"
                }
            },
            "highway_alley": {
                "zoom": 15.5,
                "type": "line",
                "color": "#dfc3c0",
                "width": 0.8,
                "dashArray": "4 2",
                "linecap": "butt"
            },
            "highway_step": {
                "zoom": 16,
                "type": "line",
                "color": "#d7b6b4",
                "width": 2.0,
                "dashArray": "2 3",
                "linecap": "butt"
            },
            "highway_substandard": {
                "zoom": 14,
                "type": "line",
                "color": "#d9d6d1",
                "width": 3.0,
                "dashArray": null,
                "linecap": "round"
            },
            "highway_standard": {
                "zoom": 14,
                "type": "line",
                "color": "#c9c6c1",
                "width": 4.0,
                "dashArray": null,
                "linecap": "round",
                "overstyle": {
                    "color": "#f0f0f0",
                    "width": 0.7,
                    "dashArray": "6 6",
                    "linecap": "butt"
                }
            },
            "highway_primary": {
                "zoom": 12,
                "type": "line",
                "color": "#f2cf5b",
                "width": 5.0,
                "dashArray": null,
                "linecap": "round",
                "overstyle": {
                    "color": "#f0f0f0",
                    "width": 1,
                    "dashArray": "8 8",
                    "linecap": "butt"
                }
            },
            "highway_motorway": {
                "zoom": 11,
                "type": "line",
                "color": "#eba985",
                "width": 6.0,
                "dashArray": null,
                "linecap": "round",
                "overstyle": {
                    "color": "#f0f0f0",
                    "width": 1,
                    "dashArray": "8 8",
                    "linecap": "butt"
                }
            },
            "building": {
                "zoom": 15,
                "type": "area",
                "color": "#cec5be",
                "width": 0.7,
                "dashArray": null,
                "linecap": "round",
                "filter": {
                    "zoom": 22,
                    "value": "drop-shadow(1px 1px 1px #80808080)"
                }
            },
            "barrier": {
                "zoom": 17,
                "type": "line",
                "color": "#aaa09a",
                "width": 0.5,
                "dashArray": null,
                "linecap": "round"
            },
            "station": {
                "zoom": 14,
                "type": "area",
                "color": "#e7cdce",
                "width": 1,
                "dashArray": null,
                "linecap": "round"
            }
        },
        "mono": {
            "background": {
                "type": "background",
                "color": "#f6f6f4",
                "opacity": 1
            },
            "sea": {
                "zoom": 11,
                "type": "area",
                "color": "#dededb",
                "width": 2,
                "dashArray": null,
                "linecap": "round"
            },
            "park": {
                "zoom": 15,
                "type": "line",
                "color": "#cfcfcb",
                "width": 2,
                "dashArray": null,
                "linecap": "round"
            },
            "waterArea": {
                "zoom": 11,
                "type": "line",
                "color": "#b8b8b5",
                "width": 2,
                "dashArray": null,
                "linecap": "round"
            },
            "waterLine": {
                "zoom": 11,
                "type": "line",
                "color": "#b8b8b5",
                "width": 2,
                "dashArray": null,
                "linecap": "round"
            },
            "wetland": {
                "zoom": 11,
                "type": "area",
                "color": "#d7d7d3",
                "width": 0.5,
                "dashArray": null,
                "linecap": "round"
            },
            "site": {
                "zoom": 15,
                "type": "area",
                "color": "#e4e4df",
                "width": 0.5,
                "dashArray": null,
                "linecap": "round"
            },
            "pedestrian": {
                "zoom": 15,
                "type": "line",
                "color": "#d3d3cf",
                "width": 1,
                "dashArray": null,
                "linecap": "round"
            },
            "parking": {
                "zoom": 15.5,
                "type": "line",
                "color": "#c8c8c4",
                "width": 2,
                "dashArray": null,
                "linecap": "round"
            },
            "garden": {
                "zoom": 16,
                "type": "line",
                "color": "#c4c4c0",
                "width": 2,
                "dashArray": null,
                "linecap": "round"
            },
            "farmland": {
                "zoom": 14,
                "type": "line",
                "color": "#ababaa",
                "width": 1,
                "dashArray": null,
                "linecap": "round"
            },
            "forest": {
                "zoom": 11,
                "type": "line",
                "color": "#969694",
                "width": 1,
                "dashArray": null,
                "linecap": "round"
            },
            "greenLine": {
                "zoom": 16,
                "type": "line",
                "color": "#8c8c8a",
                "width": 1,
                "dashArray": null,
                "linecap": "round"
            },
            "railway": {
                "zoom": 11,
                "type": "line",
                "color": "#70706f",
                "width": 2,
                "dashArray": "0",
                "linecap": "butt",
                "overstyle": {
                    "color": "#808080",
                    "width": 4,
                    "dashArray": "1 4",
                    "linecap": "butt"
                }
            },
            "highway_alley": {
                "zoom": 16,
                "type": "line",
                "color": "#cacac7",
                "width": 1,
                "dashArray": "4 2",
                "linecap": "butt"
            },
            "highway_step": {
                "zoom": 16,
                "type": "line",
                "color": "#b8b8b5",
                "width": 1.5,
                "dashArray": "2 3",
                "linecap": "butt"
            },
            "highway_substandard": {
                "zoom": 14,
                "type": "line",
                "color": "#b0b0ad",
                "width": 6.0,
                "dashArray": null,
                "linecap": "round",
                "overstyle": {
                    "color": "#ffffff",
                    "width": 3.0,
                    "dashArray": "0 0",
                    "linecap": "round",
                    "opacity": 1
                }
            },
            "highway_standard": {
                "zoom": 14,
                "type": "line",
                "color": "#969693",
                "width": 7.0,
                "dashArray": null,
                "linecap": "round",
                "overstyle": {
                    "color": "#ffffff",
                    "width": 4,
                    "dashArray": "0 0",
                    "linecap": "butt"
                }
            },
            "highway_primary": {
                "zoom": 12,
                "type": "line",
                "color": "#7f7f7d",
                "width": 8.0,
                "dashArray": null,
                "linecap": "round",
                "overstyle": {
                    "color": "#ffffff",
                    "width": 6,
                    "dashArray": "0 0",
                    "linecap": "butt"
                }
            },
            "highway_motorway": {
                "zoom": 11,
                "type": "line",
                "color": "#686866",
                "width": 10,
                "dashArray": null,
                "linecap": "round",
                "overstyle": {
                    "color": "#ffffff",
                    "width": 7,
                    "dashArray": "0 0",
                    "linecap": "butt"
                }
            },
            "building": {
                "zoom": 15,
                "type": "line",
                "color": "#8a8a88",
                "width": 2,
                "dashArray": null,
                "linecap": "round"
            },
            "barrier": {
                "zoom": 17,
                "type": "line",
                "color": "#777775",
                "width": 0.5,
                "dashArray": null,
                "linecap": "round"
            },
            "station": {
                "zoom": 14,
                "type": "line",
                "color": "#bcbcb8",
                "width": 2,
                "dashArray": null,
                "linecap": "round"
            }
        }
    }
}
