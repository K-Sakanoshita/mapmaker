{
    "editPanels": [
        {
            "groupGlot": "panelWaters",
            "styles": [
                "sea",
                "waterArea",
                "waterLine",
                "wetland"
            ]
        },
        {
            "groupGlot": "panelLands",
            "styles": [
                "background",
                "park",
                "site",
                "garden",
                "farmland",
                "forest",
                "greenLine",
                "parking",
                "pedestrian",
                "building",
                "station",
                "barrier"
            ]
        },
        {
            "groupGlot": "panelWays",
            "styles": [
                "railway",
                "recreation_track",
                "highway_motorway",
                "highway_primary",
                "highway_standard",
                "highway_substandard",
                "highway_alley",
                "highway_step"
            ]
        }
    ],
    "seasons": {
        "normal": {},
        "spring": {
            "trees": {
                "cherry": "#efc5d2",
                "ginkgo": "#aad181"
            },
            "forest": {
                "color": "#b5d39b",
                "amount": {
                    "evergreen": 0,
                    "deciduous": 0.14,
                    "mixed": 0.08,
                    "unknown": 0.08
                }
            }
        },
        "autumn": {
            "trees": {
                "cherry": "#bd886d",
                "ginkgo": "#e1c65c"
            },
            "forest": {
                "color": "#b8aa72",
                "amount": {
                    "evergreen": 0,
                    "deciduous": 0.3,
                    "mixed": 0.12,
                    "unknown": 0.12
                }
            }
        }
    },
    "model3D": {
        "tree": {
            "defaultModel": "cone",
            "rules": [
                {
                    "model": "ginkgo",
                    "when": {
                        "tags": [
                            "species",
                            "species:en",
                            "species:ja",
                            "genus",
                            "genus:en",
                            "genus:ja"
                        ],
                        "values": [
                            "Ginkgo",
                            "Ginkgo biloba",
                            "Ginkgo tree",
                            "イチョウ",
                            "銀杏"
                        ]
                    }
                },
                {
                    "model": "cherry",
                    "when": {
                        "tags": [
                            "species",
                            "species:en",
                            "species:ja",
                            "genus",
                            "genus:en",
                            "genus:ja"
                        ],
                        "values": [
                            "Cherry",
                            "Cherry blossom",
                            "Cherry tree",
                            "Japanese cherry",
                            "サクラ",
                            "桜",
                            "ソメイヨシノ",
                            "染井吉野",
                            "ヤマザクラ",
                            "シダレザクラ"
                        ],
                        "patterns": [
                            "^cerasus(?:\\s|$)",
                            "^prunus\\s+(?:[×x]\\s*)?(?:yedoensis|serrulata|subhirtella|itosakura|sargentii|speciosa)(?:\\s|$)"
                        ]
                    }
                }
            ]
        },
        "roof": {
            "defaultModel": "flat",
            "rules": [
                {
                    "model": "gabled",
                    "when": {
                        "tag": "roof:shape",
                        "values": [
                            "gabled"
                        ]
                    }
                },
                {
                    "model": "hipped",
                    "when": {
                        "tag": "roof:shape",
                        "values": [
                            "hipped"
                        ]
                    }
                },
                {
                    "model": "pyramidal",
                    "when": {
                        "tag": "roof:shape",
                        "values": [
                            "pyramidal"
                        ]
                    }
                }
            ]
        },
        "barrier": {
            "defaultModel": "flat",
            "rules": [
                {
                    "model": "rope",
                    "when": { "tag": "barrier", "values": ["rope"] }
                },
                {
                    "model": "fence",
                    "when": { "tag": "barrier", "values": ["fence"] }
                },
                {
                    "model": "wall",
                    "when": {
                        "tag": "barrier",
                        "values": [
                            "wall"
                        ]
                    }
                },
                {
                    "model": "hedge",
                    "when": {
                        "tag": "barrier",
                        "values": [
                            "hedge"
                        ]
                    }
                }
            ]
        }
    },
    "pointStyle": {
        "flagpole": {
            "radius": 0.16,
            "height": 6,
            "palette": {
                "color": { "lineColor": "#737b83", "fillColor": "#e7c56a", "width": 0.5 },
                "mono": { "lineColor": "#777777", "fillColor": "#dddddd", "width": 0.5 },
                "coloring": { "lineColor": "#444444", "fillColor": "#ffffff", "width": 0.5 }
            }
        },
        "tree": {
            "radius": 1.2,
            "palette": {
                "color": {
                    "lineColor": "#75a873",
                    "fillColor": "#9fc89d",
                    "width": 0
                },
                "mono": {
                    "lineColor": "#999999",
                    "fillColor": "#bcbcbc",
                    "width": 0.3
                },
                "coloring": {
                    "lineColor": "#444444",
                    "fillColor": "#ffffff",
                    "width": 0.5
                }
            }
        },
        "entrance": {
            "radius": 0.6,
            "palette": {
                "color": {
                    "lineColor": "#9f9892",
                    "fillColor": "#cec5be",
                    "width": 0.8
                },
                "mono": {
                    "lineColor": "#999999",
                    "fillColor": "#c6c6c6",
                    "width": 0.8
                },
                "coloring": {
                    "lineColor": "#444444",
                    "fillColor": "#ffffff",
                    "width": 0.5
                }
            }
        }
    },
